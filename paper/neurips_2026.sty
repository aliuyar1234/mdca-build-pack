
%% neurips_2026.sty -- lightweight local implementation matching the official
%% NeurIPS 2026 shell and formatting instructions.
%% Generated for this project from the official NeurIPS 2026 formatting shell
%% and public formatting rules; no style parameters are tweaked by the paper.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2026}[2026/03/20 NeurIPS 2026 style]

\newif\if@neuripsfinal
\newif\if@neuripspreprint
\newif\if@neuripsnonatbib
\newif\if@neuripsmain
\@neuripsfinalfalse
\@neuripspreprintfalse
\@neuripsnonatbibfalse
\@neuripsmaintrue

\DeclareOption{final}{\@neuripsfinaltrue}
\DeclareOption{preprint}{\@neuripspreprinttrue}
\DeclareOption{nonatbib}{\@neuripsnonatbibtrue}
\DeclareOption{main}{\@neuripsmaintrue}
\DeclareOption{position}{}
\DeclareOption{eandd}{}
\DeclareOption{creativeai}{}
\DeclareOption{sglblindworkshop}{}
\DeclareOption{dblblindworkshop}{}
\ProcessOptions\relax

\RequirePackage[letterpaper,left=1.5in,right=1.5in,top=1in,bottom=1in,footskip=0.35in]{geometry}
\RequirePackage{ifthen}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{etoolbox}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{amsmath,amssymb}
\RequirePackage{newtxtext,newtxmath}
\RequirePackage{microtype}
\RequirePackage{lineno}
\if@neuripsnonatbib\else
  \RequirePackage[numbers,sort&compress]{natbib}
\fi

\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt plus 1pt minus 1pt}
\setlength{\headheight}{14pt}
\setcounter{secnumdepth}{3}

\renewcommand{\normalsize}{%
  \@setfontsize\normalsize{10pt}{11pt}%
  \abovedisplayskip 8pt plus 2pt minus 4pt%
  \abovedisplayshortskip \z@ plus 3pt%
  \belowdisplayshortskip 5pt plus 3pt minus 3pt%
  \belowdisplayskip \abovedisplayskip
  \let\@listi\@listI}
\normalsize
\renewcommand{\small}{\@setfontsize\small{9pt}{10pt}}
\renewcommand{\footnotesize}{\@setfontsize\footnotesize{8pt}{9pt}}
\renewcommand{\scriptsize}{\@setfontsize\scriptsize{7pt}{8pt}}
\renewcommand{\large}{\@setfontsize\large{12pt}{14pt}}
\renewcommand{\Large}{\@setfontsize\Large{14pt}{16pt}}
\renewcommand{\LARGE}{\@setfontsize\LARGE{17pt}{20pt}}

\titleformat{\section}{\normalfont\bfseries\large}{\thesection}{0.5em}{}
\titleformat{\subsection}{\normalfont\bfseries\normalsize}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}{\normalfont\bfseries\normalsize}{\thesubsubsection}{0.5em}{}
\titleformat{\paragraph}[runin]{\normalfont\bfseries\normalsize}{\theparagraph}{0.5em}{}[.]
\titlespacing*{\section}{0pt}{12pt plus 2pt minus 2pt}{5pt}
\titlespacing*{\subsection}{0pt}{9pt plus 2pt minus 2pt}{3pt}
\titlespacing*{\subsubsection}{0pt}{8pt plus 2pt minus 2pt}{2pt}
\titlespacing*{\paragraph}{0pt}{6pt plus 2pt minus 2pt}{0.8em}

\setlength{\abovecaptionskip}{6pt}
\setlength{\belowcaptionskip}{0pt}

\fancypagestyle{neuripsstyle}{%
  \fancyhf{}%
  \fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}}
\pagestyle{neuripsstyle}

\newcommand{\@neuripsdraftnotice}{}
\if@neuripspreprint
  \renewcommand{\@neuripsdraftnotice}{\textit{Preprint. Work in progress.}}
\fi

\def\And{\end{tabular}\hfil\linebreak[0]\hfil%
  \begin{tabular}[t]{c}}
\def\AND{\end{tabular}\hfil\linebreak[4]\hfil%
  \begin{tabular}[t]{c}}

\renewcommand{\maketitle}{%
  \begingroup
  \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
  \thispagestyle{neuripsstyle}%
  \begin{center}
  \hrule height 4pt
  \vspace{0.25in}
  {\LARGE\bfseries \@title \par}
  \vspace{0.25in}
  \hrule height 1pt
  \vspace{0.18in}
  {\bfseries
    \if@neuripsfinal
      \@author
    \else
      Anonymous Authors
    \fi
    \par}
  \if@neuripspreprint
    \vspace{0.08in}{\small \@neuripsdraftnotice\par}
  \fi
  \end{center}
  \vspace{0.08in}
  \endgroup
  \setcounter{footnote}{0}
  \renewcommand{\thefootnote}{\arabic{footnote}}
}

\AtBeginDocument{%
  \if@neuripsfinal\else
    \if@neuripspreprint\else
      \linenumbers
    \fi
  \fi
}

\newenvironment{ack}{%
  \if@neuripsfinal
    \section*{Acknowledgments}%
  \else\if@neuripspreprint
    \section*{Acknowledgments}%
  \else
    \expandafter\comment
  \fi\fi
}{%
  \if@neuripsfinal\else\if@neuripspreprint\else\expandafter\endcomment\fi\fi
}
